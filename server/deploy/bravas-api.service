[Unit]
Description=Bravas API
After=network.target

[Service]
Type=simple
User=mike
Group=bravas-deploy
# Symlänk som deployen byter — pekar på senaste releasen under
# /srv/bravas-api/releases/. Måste vara WorkingDirectory (inte en fast sökväg)
# för att omstart ska plocka upp den nya releasen.
WorkingDirectory=/srv/bravas-api/current/server
EnvironmentFile=/srv/bravas-api/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/bravas-api/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
