STEAM_API_KEY=
SESSION_SECRET=

# Serverns id (Server Settings → Widget → Server ID). Används bara i backend:
# API:et hämtar Discords widget-JSON och visar vilka som hänger inne just nu.
# Kräver att widgeten är påslagen på samma ställe — är den av svarar Discord
# 403 och sajten visar bara inbjudningsknappen, vilket är ett giltigt läge.
DISCORD_SERVER_ID=
DISCORD_INVITE_URL=

# Adressen besökaren når sidan på. Styr både Steams returadress och OpenID-realm,
# så den måste peka dit webbläsaren faktiskt står — annars loggas man in på fel
# maskin. I drift: https://bravas.se. Lokalt: http://localhost:5173 (dev-serverns
# port, inte API:ets — /api proxas dit av Vite).
PUBLIC_ORIGIN=https://bravas.se

PORT=3001
DB_PATH=./data/bravas.db

# Valheim-server. Frågeporten är spelporten + 1 (Steams query-protokoll) och
# frågas lokalt på maskinen — inte via den publika adressen. Namn/lösenord
# visas bara för inloggade medlemmar, se server/src/routes/valheim.ts.
VALHEIM_QUERY_HOST=127.0.0.1
VALHEIM_QUERY_PORT=2457
VALHEIM_ADDRESS=valheim.bravas.se:2456
VALHEIM_SERVER_NAME=
VALHEIM_PASSWORD=
