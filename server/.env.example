STEAM_API_KEY=
SESSION_SECRET=

# Serverns id (Server Settings → Widget → Server ID). Används bara i backend:
# API:et hämtar Discords widget-JSON och visar vilka som hänger inne just nu.
# Kräver att widgeten är påslagen på samma ställe — är den av svarar Discord
# 403 och sajten visar bara inbjudningsknappen, vilket är ett giltigt läge.
DISCORD_SERVER_ID=
DISCORD_INVITE_URL=

# Adressen besökaren når sidan på. Styr både Steams returadress och OpenID-realm,
# så den måste peka dit webbläsaren faktiskt står — annars loggas man in på fel
# maskin. I drift: https://bravas.se. Lokalt: http://localhost:5173 (dev-serverns
# port, inte API:ets — /api proxas dit av Vite).
PUBLIC_ORIGIN=https://bravas.se

PORT=3001
DB_PATH=./data/bravas.db

# Valheim-server. Frågeporten är spelporten + 1 (Steams query-protokoll) och
# frågas lokalt på maskinen — inte via den publika adressen. Namn/lösenord
# visas bara för inloggade medlemmar, se server/src/routes/valheim.ts.
VALHEIM_QUERY_HOST=127.0.0.1
VALHEIM_QUERY_PORT=2457
VALHEIM_ADDRESS=valheim.bravas.se:2456
VALHEIM_SERVER_NAME=
VALHEIM_PASSWORD=

# Blizzard/Battle.net för World of Warcraft. Registreras på develop.battle.net
# under "API Access". Redirect URI måste vara exakt
# <PUBLIC_ORIGIN>/api/members/wow/callback, annars nekar Blizzard flödet.
# Utan dessa är "Länka World of Warcraft" bara en knapp som säger att det inte
# är påslaget — samma valfria mönster som Discord-widgeten.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Regionen styr både API-värd och namnrymd. eu för ett svenskt gäng.
BLIZZARD_REGION=eu

# Wargaming Developer Room application id (Server-typ). Utan den är "Länka
# World of Tanks" bara osynlig, se server/src/routes/members.ts.
WARGAMING_APPLICATION_ID=

# Vilka steamid64 som får se och använda /admin — godkänna ansökningar och ta
# bort medlemmar. Kommaseparerat. Behörigheten bor här och inte i databasen: en
# felskrivning i en tabell ska aldrig kunna låsa ut er från er egen adminsida.
# Tom variabel betyder "ingen admin", vilket är ett giltigt läge.
ADMIN_STEAMIDS=
